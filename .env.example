# Required
GEMINI_API_KEY=your-gemini-api-key

# Model Configuration (all optional — defaults shown)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview      # NanoBananaPro
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview # NanoBanana2 (faster/cheaper)
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Tool Filtering (optional)
# GEMINI_TOOL_PRESET=full        # minimal | text | image | research | media | full
# GEMINI_ENABLED_TOOLS=query,image-gen,batch-image-gen

# Image Generation
# GEMINI_IMAGE_THINKING_LEVEL=high   # minimal | low | medium | high

# Output
# GEMINI_OUTPUT_DIR=./gemini-output

# Logging
# VERBOSE=true
# QUIET=true
